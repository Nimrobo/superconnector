{
  "name": "@nimrobo/superconnector-cli",
  "version": "0.1.0",
  "description": "Command-line tools for Superconnector.",
  "type": "module",
  "bin": {
    "superconnector": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build --workspace @nimrobo/superconnector && npm run build:local",
    "build:local": "tsc -p tsconfig.json && mkdir -p dist/web && cp src/web/index.html dist/web/index.html",
    "clean": "rm -rf dist",
    "test": "npm run build --workspace @nimrobo/superconnector && node --test --import tsx test/**/*.test.ts"
  },
  "dependencies": {
    "@nimrobo/superconnector": "0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "cli",
    "superconnector"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nimrobo/superconnector.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Nimrobo/superconnector/issues"
  },
  "homepage": "https://nimroboai.com",
  "license": "MIT"
}
